{
  "name": "@ugandaemr/esm-patient-registration-app",
  "version": "12.0.0",
  "description": "Patient registration microfrontend for the UgandaEMR frontend",
  "browser": "dist/esm-patient-registration-app.js",
  "main": "src/index.ts",
  "source": true,
  "files": [
    "*"
  ],
  "license": "MPL-2.0",
  "homepage": "https://github.com/METS-Programme/esm-patient-registration-app#readme",
  "scripts": {
    "start": "openmrs develop",
    "serve": "rspack serve --mode=development",
    "debug": "npm run serve",
    "build": "rspack --mode production",
    "analyze": "rspack --mode=production --env.analyze=true",
    "lint": "eslint src",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest watch",
    "coverage": "vitest run --coverage --passWithNoTests",
    "typescript": "tsc",
    "verify": "yarn lint && yarn typescript && yarn test",
    "extract-translations": "i18next 'src/**/*.component.tsx' 'src/**/*.extension.tsx' 'src/**/*modal.tsx' 'src/index.ts' 'src/patient-registration/validation/patient-registration-validation.ts' --config tools/i18next-parser.config.js",
    "prepack": "cp src/routes.json routes.json",
    "postpack": "rm -f routes.json",
    "postinstall": "husky"
  },
  "browserslist": [
    "extends browserslist-config-openmrs"
  ],
  "keywords": [
    "openmrs",
    "ugandaemr"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/METS-Programme/esm-patient-registration-app.git"
  },
  "bugs": {
    "url": "https://github.com/METS-Programme/esm-patient-registration-app/issues"
  },
  "dependencies": {
    "classnames": "^2.3.2",
    "formik": "^2.1.5",
    "lodash-es": "^4.17.15",
    "uuid": "^8.3.2",
    "yup": "^0.29.1"
  },
  "peerDependencies": {
    "@carbon/react": "1.x",
    "@openmrs/esm-framework": "11.x",
    "dayjs": "1.x",
    "react": "18.x",
    "react-dom": "18.x",
    "react-i18next": "16.x",
    "react-router-dom": "6.x",
    "swr": "2.x"
  },
  "devDependencies": {
    "@carbon/react": "~1.92.1",
    "@openmrs/eslint-config": "^2.0.0",
    "@openmrs/esm-framework": "11.0.1-pre.5776",
    "@openmrs/esm-service-queues-app": "^12.1.2-pre.9959",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.5.1",
    "@types/jsdom": "^28",
    "@types/lodash-es": "^4.17.3",
    "@types/react": "^18.3.21",
    "@types/react-dom": "^18.3.0",
    "@types/react-router-dom": "^5.3.3",
    "@types/uuid": "^8.3.0",
    "@types/webpack-env": "^1.16.0",
    "@types/yup": "^0.29.11",
    "@vitest/coverage-v8": "^4.1.2",
    "dayjs": "^1.8.36",
    "eslint": "^9.39.0",
    "happy-dom": "^20.0.0",
    "husky": "^9.1.7",
    "i18next": "^25.0.0",
    "i18next-parser": "^9.3.0",
    "identity-obj-proxy": "^3.0.0",
    "jsdom": "^28",
    "lint-staged": "^15.2.1",
    "openmrs": "next",
    "prettier": "3.9.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^16.0.0",
    "react-router-dom": "^6.3.0",
    "sass": "^1.29.0",
    "swr": "2.5.1",
    "typescript": "^5.0.0",
    "vitest": "^4.1.2"
  },
  "lint-staged": {
    "*.{ts,tsx}": "eslint --fix --max-warnings 0",
    "*.{css,scss,ts,tsx}": "prettier --cache --write --list-different"
  },
  "packageManager": "yarn@4.9.2"
}
